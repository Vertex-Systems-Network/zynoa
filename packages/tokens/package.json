{
  "name": "@zynoa/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Zynoa design tokens for web (CSS, Tailwind, shadcn/ui), desktop and React Native.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./typography.css": "./dist/typography.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./shadcn.css": "./dist/shadcn.css",
    "./tailwind.preset": "./dist/tailwind.preset.cjs",
    "./tokens.json": "./src/tokens.json",
    "./colors.resolved.json": "./dist/colors.resolved.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs && git diff --exit-code -- dist && test -z \"$(git status --porcelain -- dist)\"",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@zynoa/config": "workspace:*",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
