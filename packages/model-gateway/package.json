    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.87",
    "@zynoa/config": "workspace:*",
    "ai": "7.0.142",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
