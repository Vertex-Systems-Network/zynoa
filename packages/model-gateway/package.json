{
  "name": "@zynoa/model-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "ModelGateway: provider adapters, pricing and token accounting (ENGINEERING-RULES: no business code imports a provider SDK directly).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
