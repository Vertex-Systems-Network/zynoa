{
  "name": "@zynoa/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, DTOs and error codes for every Zynoa app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@zynoa/config": "workspace:*",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
