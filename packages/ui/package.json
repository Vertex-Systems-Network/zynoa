{
  "name": "@zynoa/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Zynoa shared React components (tokens-based, WCAG 2.2 AA).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && storybook build --quiet",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "storybook dev -p 6006"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "radix-ui": "1.8.1",
    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@zynoa/config": "workspace:*",
    "@zynoa/tokens": "workspace:*",
    "autoprefixer": "10.6.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.30",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
