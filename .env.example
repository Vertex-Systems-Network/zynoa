# Zynoa environment variables — copy to .env for local development.
# Defined and validated in packages/config/src/env.ts (Zod). Each process loads only the groups it needs;
# a missing or invalid variable stops the process at startup and names the variable.
# Never commit real secrets. Local defaults below match infra/docker (WU-P0-02).

# --- core (always) ---
NODE_ENV=development
APP_ENV=local                      # local | ci | preview | staging | production
APP_URL=http://localhost:3000
PREVIEW_DOMAIN=                    # pending OD-02 (separate registrable domains)
RENDER_DOMAIN=
ASSET_DOMAIN=

# --- database ---
DATABASE_URL=postgres://zynoa:zynoa@localhost:5432/zynoa
# --- databasePlatform (migration runner and operator jobs only; bypasses tenant RLS) ---
DATABASE_PLATFORM_URL=postgres://zynoa_platform:zynoa@localhost:5432/zynoa

# --- redis ---
REDIS_URL=redis://localhost:6379

# --- temporal ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TLS_CERT=                 # cloud only; set together with TEMPORAL_TLS_KEY
TEMPORAL_TLS_KEY=

# --- storage (S3-compatible; SeaweedFS locally (ADR-015), Cloudflare R2 in cloud) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=zynoa
S3_SECRET_ACCESS_KEY=zynoa-local-only
S3_BUCKET_PRIVATE=zynoa-private
S3_BUCKET_PUBLIC=zynoa-public

# --- keys (envelope encryption) ---
KMS_KEY_ID=                        # required outside local/ci
LOCAL_MASTER_KEY=                  # local/ci only: 64 hex chars, e.g. `openssl rand -hex 32`

# --- auth ---
BETTER_AUTH_SECRET=                # >= 32 chars, e.g. `openssl rand -base64 48`
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- email ---
EMAIL_PROVIDER=mock                # mock | resend | postmark | ses (mock not allowed in production)
EMAIL_API_KEY=
EMAIL_FROM=
MAILPIT_URL=http://localhost:8025   # mock provider relays here so mail shows in the Mailpit inbox

# --- models ---
MODEL_PROVIDERS_ENABLED=mock       # comma list: mock, openai, anthropic, google
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- sandbox ---
SANDBOX_PROVIDER=mock
SANDBOX_API_KEY=

# --- github app (Phase 2) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- deploy ---
DEPLOY_PROVIDER=mock

# --- modes ---
WORKER_QUEUES=                     # comma list; empty = all
MESSAGING_MODE=capture             # capture | live
PAYMENTS_MODE=test                 # test | live (test not allowed in production)

# --- captcha (Cloudflare Turnstile) ---
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=

# --- observability ---
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- feature flags ---
FEATURE_FLAGS_FILE=                # optional JSON file of flag rows; everything is off by default
