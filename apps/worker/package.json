  },
  "devDependencies": {
    "@temporalio/client": "1.24.0",
    "@temporalio/testing": "1.24.0",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
